# Basis Data Turso / libSQL (Gunakan file:local.db untuk development lokal tanpa akun Turso Cloud)
TURSO_DATABASE_URL="file:local.db"
TURSO_AUTH_TOKEN=""

# JWT Secret (Minimal 32 karakter acak untuk enkripsi cookie auth_token)
JWT_SECRET="sbd-laundry-secret-key-super-secure-min-32-chars-long"

# Port server API Hono di mode lokal
PORT=3001
